# Application Configuration
NODE_ENV=development
PORT=3000
# Bind to loopback for local use. 0.0.0.0 listens on EVERY interface and
# disables the control-gateway token gate, so it requires CONTROL_API_TOKEN —
# the server refuses to boot otherwise.
HOST=127.0.0.1
# Required only when HOST is not loopback. Any client then sends
# "Authorization: Bearer <token>".
# CONTROL_API_TOKEN=change-me

# Redis Configuration (Distributed Locks & State)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Spatial & Matching Configuration
SPATIAL_ENGINE=cpp
DEFAULT_OFFER_TIMEOUT_MS=15000
DEFAULT_SEARCH_RADIUS_METERS=10000
DEFAULT_K_NEAREST=4
