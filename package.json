{
  "name": "rt-ride-matching-system",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-Time Ride Matching Platform",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "test": "tsx tests/test_driver_registry.ts",
    "test:registry": "tsx tests/test_driver_registry.ts",
    "test:concurrency": "tsx tests/test_concurrency_race.ts",
    "test:quadtree": "tsx tests/test_quadtree.ts",
    "test:dryrun": "tsx tests/quadtree.dryrun.ts",
    "test:state-machine": "tsx tests/test_trip_state_machine.ts",
    "test:matching": "tsx tests/test_matching_service.ts",
    "test:audit": "tsx tests/test_audit_fixes.ts",
    "test:integration": "tsx tests/test_integration_edge_cases.ts",
    "test:all": "tsx tests/integration_all.ts",
    "test:all:stress": "tsx tests/integration_all.ts --stress",
    "dev:frontend": "vite frontend",
    "build:frontend": "vite build frontend",
    "preview:frontend": "vite preview frontend",
    "build:cpp": "g++ -O3 -std=c++14 cpp-engine/engine_bridge.cpp -o cpp-engine/engine_bridge.exe",
    "benchmark:1M:cpp": "g++ -O3 -std=c++14 cpp-engine/benchmark_1M.cpp -lpsapi -o cpp-engine/benchmark_1M.exe && cpp-engine\\benchmark_1M.exe",
    "benchmark:1M:ts": "tsx tests/benchmark_1M_ts.ts",
    "stress:3m:cpp": "g++ -O3 -std=c++14 -I cpp-engine cpp-engine/stress_3M.cpp -L cpp-engine -lh3 -lpsapi -o cpp-engine/stress_3M.exe && cpp-engine\\stress_3M.exe",
    "stress:3m:ts": "tsx tests/benchmark_3M_ts.ts",
    "monitoring:up": "docker compose -f docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker compose -f docker-compose.monitoring.yml down"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "koffi": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ioredis": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
